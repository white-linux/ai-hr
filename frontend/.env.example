# Copy to .env.local and adjust. Every VITE_* variable is bundled into the
# browser build — NEVER put LLM / OpenAI / Anthropic API keys here.
# AI provider keys belong on the backend only.

# true  -> UI runs on in-browser mock data (src/mocks)
# false -> UI calls the real backend through src/services/apiClient.js
VITE_USE_MOCKS=true

# Base path for backend requests (relative path works with the dev proxy below)
VITE_API_BASE_URL=/api

# Local backend for the Vite dev proxy, e.g. http://localhost:8000
VITE_API_PROXY_TARGET=

# How often to poll for returned tasks, in ms (0 disables polling)
VITE_SUBMISSION_POLL_MS=5000

# Fake network delay for mock responses, in ms
VITE_MOCK_LATENCY_MS=600
